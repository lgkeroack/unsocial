# Database (for tracking backup jobs and user sessions)
# In production, use a managed PostgreSQL service (e.g., Supabase, Neon, Railway)
DATABASE_URL=postgresql://user:password@localhost:5432/unsocial_me

# Redis (for background job queue)
# Optional: app falls back to in-process execution when unavailable
REDIS_URL=redis://localhost:6379

# NextAuth Configuration
# In production, set NEXTAUTH_URL to your deployed domain (e.g., https://unsocial.me)
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate-this-with-openssl-rand-base64-32

# Meta Developer App (for Instagram & Facebook OAuth)
# Get these from: https://developers.facebook.com/apps
# Users will authenticate through OAuth - these are YOUR app credentials
# NEVER commit actual values - use environment variables in production
NEXT_PUBLIC_META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# LinkedIn Developer App (for LinkedIn OAuth)
# Get these from: https://www.linkedin.com/developers/apps
# Users will authenticate through OAuth - these are YOUR app credentials
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# File Storage (Cloudflare R2 or AWS S3)
# For temporarily storing user backup archives (7-day auto-delete)
# In production, use IAM roles or service accounts instead of static keys where possible
STORAGE_ENDPOINT=https://your-account.r2.cloudflarestorage.com
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=your-r2-access-key
STORAGE_SECRET_KEY=your-r2-secret-key
STORAGE_BUCKET=unsocial-me-backups
STORAGE_PUBLIC_URL=https://your-bucket.r2.dev

# Email Service (for download notifications)
# Get API key from: https://resend.com
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=noreply@unsocial.me

# Admin Dashboard Access
# Comma-separated list of email addresses with admin privileges
ADMIN_EMAILS=admin@unsocial.me
